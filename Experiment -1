import matplotlib.pyplot as plt
import numpy as np
import tensorflow as tf
import pandas as pd
from sklearn import preprocessing

# Specify 'Ridge' or 'LASSO'
regression_type = 'LASSO'
# regression_type = 'Ridge'

# Load dataset
hp = pd.read_csv('house_train.csv')
print(hp.columns)

# Extract YearBuilt and SalePrice
hp_arr = hp[['YearBuilt', 'SalePrice']].to_numpy().astype('float64')
print(hp_arr[:5])

x_vals = np.array([x[0] for x in hp_arr])
y_vals = np.array([y[1] for y in hp_arr])

print(x_vals[:10])
print(x_vals.shape)
print(y_vals[:10])
print(y_vals.shape)

# Scale features and target
x_scaler = preprocessing.MinMaxScaler()
y_scaler = preprocessing.MinMaxScaler()

x_scaled = x_scaler.fit_transform(x_vals.reshape(-1, 1))
y_scaled = y_scaler.fit_transform(y_vals.reshape(-1, 1))

x_scaled = x_scaled.flatten()
y_scaled = y_scaled.flatten()

###
# Model Parameters
###
batch_size = 50

# Make results reproducible
seed = 13
np.random.seed(seed)
tf.random.set_seed(seed)

# Create variables for linear regression
A = tf.Variable(tf.random.normal(shape=[1, 1], dtype='float64'))
b = tf.Variable(tf.random.normal(shape=[1, 1], dtype='float64'))
print("A = ", A.numpy())
print("b = ", b.numpy())


def lasso_loss(y, o, a):
    # Declare Lasso Loss function
    # Lasso Loss = L2_Loss + heavyside_step
    lasso_param = tf.constant(0.9, dtype='float64')
    heavyside_step = tf.math.truediv(
        tf.constant(1., dtype='float64'),
        tf.math.add(
            tf.constant(1., dtype='float64'),
            tf.math.exp(
                tf.multiply(
                    tf.constant(-100., dtype='float64'),
                    tf.math.subtract(a, lasso_param)
                )
            )
        )
    )
    regularization_param = tf.multiply(heavyside_step, 99.)
    loss = tf.math.add(tf.math.reduce_mean(tf.square(y - o)), regularization_param)
    return loss


def ridge_loss(y, o, a):
    # Declare the Ridge Loss function
    # Ridge Loss = L2_Loss + L2 norm of slope
    ridge_param = tf.constant(1., dtype='float64')
    ridge_loss_val = tf.reduce_mean(tf.square(a))
    loss = tf.expand_dims(
        tf.add(tf.reduce_mean(tf.square(y - o)), tf.multiply(ridge_param, ridge_loss_val)),
        0
    )
    return loss


###
# Optimizer
###
my_opt = tf.keras.optimizers.SGD(0.001)

# Training Loop
loss_vec = []
for i in range(3000):
    rand_index = np.random.choice(len(x_vals), size=batch_size)
    rand_x = np.transpose([x_scaled[rand_index]])
    rand_y = np.transpose([y_scaled[rand_index]])

    with tf.GradientTape() as tape:
        model_output = tf.math.add(tf.matmul(rand_x, A), b)
        if regression_type == 'LASSO':
            temp_loss = lasso_loss(rand_y, model_output, A)
        else:
            temp_loss = ridge_loss(rand_y, model_output, A)

    grads = tape.gradient(temp_loss, [A, b])
    my_opt.apply_gradients(zip(grads, [A, b]))
    loss_vec.append(temp_loss[0])

    if (i + 1) % 600 == 0:
        print('Step #' + str(i + 1) + ' A = ' + str(A.numpy()) + ' b = ' + str(b.numpy()))
        print('Loss = ' + str(temp_loss.numpy()))
        print('\n')

###
# Extract regression results
###
slope = A.numpy()[0][0]
y_intercept = b.numpy()[0][0]
print("A = ", slope)
print("b = ", y_intercept)

# Get best fit line
best_fit = []
for i in x_scaled:
    best_fit.append(slope * i + y_intercept)

pred = np.array(best_fit)
pred = y_scaler.inverse_transform(pred.reshape(-1, 1))
pred = pred.flatten()
print(pred[:10])

###
# Plot results
###
plt.plot(x_vals, y_vals, 'o', label='Data Points')
plt.plot(x_vals, pred, 'r-', label='Best fit line', linewidth=3)
plt.legend(loc='upper left')
plt.title('House Price vs Year Built')
plt.xlabel('Year Built')
plt.ylabel('House Price')
plt.show()

# Plot Loss over time
plt.plot(loss_vec, 'k-')
plt.title(regression_type + ' Loss per Generation')
plt.xlabel('Generation')
plt.ylabel('Loss')
plt.show()